<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@android:color/white">

    <!-- Header: App name + Status icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Waddy"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#333333" />

        <ImageView
            android:id="@+id/iv_status_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_package"
            android:contentDescription="Status icon" />
    </LinearLayout>

    <!-- Status subtitle -->
    <TextView
        android:id="@+id/tv_status_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Order is on the way"
        android:textSize="11sp"
        android:textColor="#666666"
        android:layout_marginTop="2dp" />

    <!-- ETA text -->
    <TextView
        android:id="@+id/tv_eta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Arriving in 9 mins"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="4dp" />

    <!-- Progress bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/notification_progress_bg" />

        <View
            android:id="@+id/progress_fill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/notification_progress_fill" />
    </FrameLayout>

</LinearLayout>
